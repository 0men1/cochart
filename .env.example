NODE_ENV=development

# Host/port the api (or combined dev) server binds to.
HOSTNAME=0.0.0.0
PORT=3000

ROOM_DB_PATH=

# Set to 1 when the api service runs behind a reverse proxy
TRUST_PROXY=

# Optional: enables the feedback/suggestions endpoint, which opens GitHub
# issues. Leave GITHUB_TOKEN unset to disable the feature.
# GITHUB_TOKEN=
# GITHUB_REPO=0men1/cochart

# Dev-only: comma-separated origins allowed to make cross-origin dev requests.
# Has no effect in production.
ALLOWED_DEV_ORIGINS=
