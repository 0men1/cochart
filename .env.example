# Example environment configuration for the CoChart server (server.ts).
# Copy to `.env` and adjust as needed. The core app needs no secrets or API
# keys; only the optional feedback/suggestions feature does (see below).

# "development" or "production". Controls Next.js dev vs. prod mode.
NODE_ENV=development

# Host the server binds to.
HOSTNAME=0.0.0.0

# Port the server listens on.
PORT=3000

# Path to the SQLite file where collab rooms are persisted, so rooms survive a
# server restart. Defaults to ./data/rooms.db (git-ignored) when unset.
ROOM_DB_PATH=

# Dev-only: comma-separated origins allowed to make cross-origin dev requests
# Has no effect in production.
ALLOWED_DEV_ORIGINS=
