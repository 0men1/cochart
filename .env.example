# Example environment configuration for the CoChart server (server.ts).
# Copy to `.env` and adjust as needed. All values are optional — the defaults
# below are what the server falls back to. No secrets or API keys are required.

# "development" or "production". Controls Next.js dev vs. prod mode.
NODE_ENV=development

# Host the server binds to.
HOSTNAME=0.0.0.0

# Port the server listens on.
PORT=3000

# Dev-only: comma-separated origins allowed to make cross-origin dev requests
# (HMR, RSC, static chunks). Only needed when running `npm run dev` against a
# remote host by IP/domain, e.g. ALLOWED_DEV_ORIGINS=192.168.1.10,example.dev
# Has no effect in production.
ALLOWED_DEV_ORIGINS=
