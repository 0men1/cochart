    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cochart-charts": "^1.0.0",
    "immer": "^11.1.3",
    "lucide-react": "^0.511.0",
